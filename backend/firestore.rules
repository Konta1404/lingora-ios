rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /data/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared translation cache: anyone signed in can read; only Cloud Functions write.
    match /vocabTranslations/{lang}/words/{wordId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Usage counters are written by Cloud Functions only.
    match /usage/{doc} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
