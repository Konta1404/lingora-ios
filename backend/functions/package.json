{
  "name": "lingora-functions",
  "private": true,
  "main": "lib/src/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions,firestore",
    "logs": "firebase functions:log",
    "seed": "npm run build && node lib/scripts/seed-translations.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
