    "You chose %@, so most of your %@ time goes to listening and speaking. %@ is spaced out so it sticks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$@ gewählt, deshalb geht der Großteil deiner Zeit für %2$@ ins Hören und Sprechen. %3$@ wird verteilt, damit es hängen bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You chose %@, so most of your %@ time goes to listening and speaking. %@ is spaced out so it sticks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegiste %1$@, así que la mayor parte de tu tiempo de %2$@ va a escuchar y hablar. %3$@ se reparte para que se quede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as choisi %1$@, donc l’essentiel de ton temps de %2$@ va à l’écoute et à l’oral. %3$@ est réparti pour bien s’ancrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai scelto %1$@, quindi gran parte del tempo di %2$@ va ad ascolto e parlato. %3$@ è distribuito perché resti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você escolheu %1$@, então a maior parte do seu tempo de %2$@ vai para ouvir e falar. %3$@ é espaçado para fixar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выбрали %1$@, поэтому большая часть времени (%2$@) уходит на аудирование и говорение. %3$@ распределено, чтобы лучше запомнилось."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izabrao si: %1$@, pa većina vremena za %2$@ ide na slušanje i govor. %3$@ je raspoređeno kroz sedmicu da bolje zapamtiš."
          }
        }
      }
    },
