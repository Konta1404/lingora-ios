    "%@! Let’s practise %@. Tell me a little about yourself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@! Let’s practise %@. Tell me a little about yourself."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@! Hajde da vježbamo (%2$@). Reci mi nešto o sebi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@! Lass uns %2$@ üben. Erzähl mir ein bisschen von dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡%1$@! Practiquemos %2$@. Cuéntame un poco sobre ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ! Pratiquons le %2$@. Parle-moi un peu de toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@! Facciamo pratica di %2$@. Parlami un po’ di te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@! Vamos praticar %2$@. Conte um pouco sobre você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@! Давайте практиковаться (%2$@). Расскажите немного о себе."
          }
        }
      }
    },
