    "Every noun has a gender: der (masculine), die (feminine), das (neuter). Learn the article with the word." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Nomen hat ein Genus: der (maskulin), die (feminin), das (neutral). Lerne den Artikel mit dem Wort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every noun has a gender: der (masculine), die (feminine), das (neuter). Learn the article with the word."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada sustantivo tiene género: der (masculino), die (femenino), das (neutro). Aprende el artículo con la palabra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque nom a un genre : der (masculin), die (féminin), das (neutre). Apprends l’article avec le mot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni sostantivo ha un genere: der (maschile), die (femminile), das (neutro). Impara l’articolo con la parola."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo substantivo tem gênero: der (masculino), die (feminino), das (neutro). Aprenda o artigo com a palavra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого существительного есть род: der (м.), die (ж.), das (ср.). Учи артикль вместе со словом."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka imenica ima rod: der (muški), die (ženski), das (srednji). Uči član zajedno s riječju."
          }
        }
      }
    },
