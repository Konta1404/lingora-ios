    "For security, log out and sign in again, then delete your account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For security, log out and sign in again, then delete your account."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz bezbjednosnih razloga se odjavi i ponovo prijavi, pa onda obriši nalog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Sicherheitsgründen melde dich ab und wieder an und lösche dann dein Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por seguridad, cierra sesión, vuelve a entrar y luego elimina tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par sécurité, déconnecte-toi, reconnecte-toi, puis supprime ton compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per sicurezza, esci e accedi di nuovo, poi elimina l’account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por segurança, saia e entre novamente, depois exclua sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целях безопасности выйдите и войдите снова, затем удалите аккаунт."
          }
        }
      }
    },
