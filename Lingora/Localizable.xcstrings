    "Only a fingerprint of each email address is checked; your contacts aren't uploaded." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geprüft wird nur ein Fingerabdruck jeder E-Mail-Adresse; deine Kontakte werden nicht hochgeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a fingerprint of each email address is checked; your contacts aren't uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se comprueba una huella de cada correo; tus contactos no se suben."
