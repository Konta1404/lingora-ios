    "ChatGPT plans your week, adapts it every day and practises with you. Learn with friends, on every device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT plans your week, adapts it every day and practises with you. Learn with friends, on every device."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT planira tvoju sedmicu, prilagođava je svaki dan i vježba s tobom. Uči s prijateljima, na svakom uređaju."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT plant deine Woche, passt sie täglich an und übt mit dir. Lerne mit Freunden, auf jedem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT planifica tu semana, la adapta cada día y practica contigo. Aprende con amigos, en cualquier dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT planifie ta semaine, l’adapte chaque jour et pratique avec toi. Apprends avec des amis, sur tous tes appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT pianifica la tua settimana, la adatta ogni giorno e si esercita con te. Impara con gli amici, su ogni dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ChatGPT planeja sua semana, ajusta todo dia e pratica com você. Aprenda com amigos, em qualquer dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT планирует вашу неделю, подстраивает её каждый день и практикуется с вами. Учитесь с друзьями на любом устройстве."
          }
        }
      }
    },
