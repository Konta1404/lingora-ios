    "Goethe-Institut word lists, A1 → A2 → B1. Words come in random order. Nouns need their article and plural, verbs their Perfekt." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wortlisten des Goethe-Instituts, A1 → A2 → B1. Die Wörter kommen in zufälliger Reihenfolge. Nomen brauchen Artikel und Plural, Verben ihr Perfekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goethe-Institut word lists, A1 → A2 → B1. Words come in random order. Nouns need their article and plural, verbs their Perfekt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listas de vocabulario del Goethe-Institut, A1 → A2 → B1. Las palabras salen en orden aleatorio. Los sustantivos necesitan artículo y plural; los verbos, su Perfekt."
          }
        },
        "fr" : {
          "stringUnit" : {
