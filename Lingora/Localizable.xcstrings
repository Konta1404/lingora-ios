    "Removing a device here only hides it from this list. To sign out everywhere, change your password or remove Lingora from your Apple, Google or ChatGPT account settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gerät hier zu entfernen blendet es nur aus der Liste aus. Um dich überall abzumelden, ändere dein Passwort oder entferne Lingora in den Einstellungen deines Apple-, Google- oder ChatGPT-Kontos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing a device here only hides it from this list. To sign out everywhere, change your password or remove Lingora from your Apple, Google or ChatGPT account settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar un dispositivo aquí solo lo oculta de la lista. Para cerrar sesión en todas partes, cambia tu contraseña o quita Lingora de los ajustes de tu cuenta de Apple, Google o ChatGPT."
          }
        },
