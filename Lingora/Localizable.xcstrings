            "state": "translated",
            "value": "Alle peilen 60 Min. an – gemeinsam fertig werden, gemeinsam feiern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos apuntan a 60 min: terminad juntos, celebrad juntos."
