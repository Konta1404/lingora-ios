            "state": "translated",
            "value": "ChatGPT couldn't be reached for some plans, so we used a standard plan for now."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT nije bio dostupan za neke planove, pa smo za sada koristili standardni plan."
