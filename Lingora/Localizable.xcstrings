    "Goethe-Institut word lists, A1 → A2 → B1. Words come in random order. Nouns need their article and plural, verbs their Perfekt." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wortlisten des Goethe-Instituts, A1 → A2 → B1. Die Wörter kommen in zufälliger Reihenfolge. Nomen brauchen Artikel und Plural, Verben ihr Perfekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goethe-Institut word lists, A1 → A2 → B1. Words come in random order. Nouns need their article and plural, verbs their Perfekt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listas de vocabulario del Goethe-Institut, A1 → A2 → B1. Las palabras salen en orden aleatorio. Los sustantivos necesitan artículo y plural; los verbos, su Perfekt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listes de mots du Goethe-Institut, A1 → A2 → B1. Les mots arrivent dans un ordre aléatoire. Les noms demandent l’article et le pluriel, les verbes leur Perfekt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste di parole del Goethe-Institut, A1 → A2 → B1. Le parole arrivano in ordine casuale. I sostantivi vogliono articolo e plurale, i verbi il Perfekt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listas de palavras do Goethe-Institut, A1 → A2 → B1. As palavras vêm em ordem aleatória. Substantivos pedem artigo e plural; verbos, o Perfekt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Списки слов Гёте-института, A1 → A2 → B1. Слова идут в случайном порядке. Для существительных нужен артикль и множественное число, для глаголов — Perfekt."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste riječi Goethe-Instituta, A1 → A2 → B1. Riječi dolaze nasumičnim redom. Uz imenice ide član i množina, uz glagole Perfekt."
          }
        }
      }
    },
