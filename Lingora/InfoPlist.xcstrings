    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingora wandelt deine Sprache in Text um, damit du sprechend antworten kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingora turns your speech into text so you can answer by speaking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingora convierte tu voz en texto para que puedas responder hablando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingora transforme ta voix en texte pour que tu puisses répondre à l’oral."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingora trasforma la tua voce in testo così puoi rispondere parlando."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lingora transforma sua fala em texto para você responder falando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingora превращает речь в текст, чтобы ты мог(ла) отвечать голосом."
          }
