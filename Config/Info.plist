<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Google Sign-In redirects back to the app through this URL scheme.
	     Set GOOGLE_REVERSED_CLIENT_ID in Build Settings to REVERSED_CLIENT_ID from GoogleService-Info.plist. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
		<!-- Invite links and QR codes: lingora://add/<username> -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.veselin.lingora</string>
			<key>CFBundleURLRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lingora</string>
			</array>
		</dict>
	</array>
	<!-- Checks for new messages in the background (local notifications; no push needed). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.veselin.lingora.refresh</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Lingora uses the microphone when you dictate a reply in the language you're practising.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lingora turns your speech into text so you can answer by speaking.</string>
	<key>NSContactsUsageDescription</key>
	<string>Lingora checks which of your contacts are on Lingora. Only a fingerprint of each email address is compared; your contacts aren't uploaded.</string>
	<!-- Lingora backend URL when it runs outside Firebase Functions (e.g. Render). Set LINGORA_API_URL in Build Settings. -->
	<key>LingoraAPIURL</key>
	<string>$(LINGORA_API_URL)</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
</dict>
</plist>
